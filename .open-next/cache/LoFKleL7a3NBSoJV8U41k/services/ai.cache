s-center justify-center gap-2 whitespace-nowrap text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg]:size-4 [&amp;_svg]:shrink-0 border border-input bg-background hover:bg-accent hover:text-accent-foreground h-11 rounded-md px-8\">مشاوره رایگان</button></div></div></div></section><section class=\"section-padding\"><div class=\"container-custom\"><div class=\"grid grid-cols-2 md:grid-cols-4 gap-8\"><div class=\"text-center animate-fade-in\"><div class=\"text-4xl font-bold text-purple-600 mb-2\">+۱۰۰</div><div class=\"text-gray-600\">پروژه AI موفق</div></div><div class=\"text-center animate-fade-in\"><div class=\"text-4xl font-bold text-purple-600 mb-2\">۵۰%</div><div class=\"text-gray-600\">افزایش بهره‌وری</div></div><div class=\"text-center animate-fade-in\"><div class=\"text-4xl font-bold text-purple-600 mb-2\">۲۴/۷</div><div class=\"text-gray-600\">کارکرد بدون وقفه</div></div><div class=\"text-center animate-fade-in\"><div class=\"text-4xl font-bold text-purple-600 mb-2\">۹۰%</div><div class=\"text-gray-600\">رضایت مشتریان</div></div></div></div></section><section class=\"section-padding bg-gradient-to-br from-purple-50 to-blue-50\"><div class=\"container-custom\"><div class=\"text-center mb-12\"><h2 class=\"text-3xl md:text-4xl font-bold mb-6\">راه‌حل‌های هوش مصنوعی ما</h2><p class=\"text-xl text-gray-600 max-w-2xl mx-auto\">مجموعه کاملی از خدمات هوش مصنوعی برای رشد و توسعه کسب‌وکار شما</p></div><div class=\"grid md:grid-cols-2 lg:grid-cols-3 gap-8\"><div class=\"rounded-lg border bg-card text-card-foreground shadow-sm hover:shadow-xl transition-shadow animate-fade-in group relative overflow-hidden\"><div class=\"inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-semibold transition-colors focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2 border-transparent text-primary-foreground absolute top-4 left-4 bg-green-500 hover:bg-green-600\">جدید</div><div class=\"flex flex-col space-y-1.5 p-6\"><div class=\"w-14 h-14 bg-gradient-to-r from-purple-500 to-purple-700 rounded-xl flex items-center justify-center mb-4\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-sparkles h-7 w-7 text-white\"><path d=\"M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z\"></path><path d=\"M20 3v4\"></path><path d=\"M22 5h-4\"></path><path d=\"M4 17v2\"></path><path d=\"M5 18H3\"></path></svg></div><h3 class=\"text-2xl font-semibold leading-none tracking-tight group-hover:text-purple-600 transition-colors\">تولید محتوای هوشمند</h3></div><div class=\"p-6 pt-0\"><p class=\"text-gray-600 mb-4\">تولید محتوای متنی و ویدیویی با هوش مصنوعی</p><ul class=\"space-y-2 text-sm text-gray-600\"><li>• <!-- -->تولید مقاله و متن</li><li>• <!-- -->ساخت ویدیو با AI</li><li>• <!-- -->سناریونویسی هوشمند</li><li>• <!-- -->محتوای شبکه‌های اجتماعی</li></ul></div></div><div class=\"rounded-lg border bg-card text-card-foreground shadow-sm hover:shadow-xl transition-shadow animate-fade-in group relative overflow-hidden\"><div class=\"inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-semibold transition-colors focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2 border-transparent text-primary-foreground absolute top-4 left-4 bg-green-500 hover:bg-green-600\">جدید</div><div class=\"flex flex-col space-y-1.5 p-6\"><div class=\"w-14 h-14 bg-gradient-to-r from-blue-500 to-blue-700 rounded-xl flex items-center justify-center mb-4\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-bot h-7 w-7 text-white\"><path d=\"M12 8V4H8\"></path><rect width=\"16\" height=\"12\" x=\"4\" y=\"8\" rx=\"2\"></rect><path d=\"M2 14h2\"></path><path d=\"M20 14h2\"></path><path d=\"M15 13v2\"></path><path d=\"M9 13v2\"></path></svg></div><h3 class=\"text-2xl font-semibold leading-none tracking-tight group-hover:text-purple-600 transition-colors\">بازاریابی و تعامل AI</h3></div><div class=\"p-6 pt-0\"><p class=\"text-gray-600 mb-4\">اتوماسیون بازاریابی، چت‌بات و شخصی‌سازی تجربه مشتری</p><ul class=\"space-y-2 text-sm text-gray-600\"><li>• <!-- -->اتوماسیون بازاریابی</li><li>• <!-- -->چت‌بات هوشمند فارسی</li><li>• <!-- -->شخصی‌سازی محتوا</li><li>• <!-- -->تعامل خودکار با مشتری</li></ul></div></div><div class=\"rounded-lg border bg-card text-card-foreground shadow-sm hover:shadow-xl transition-shadow animate-fade-in group relative overflow-hidden\"><div class=\"inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-semibold transition-colors focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2 border-transparent text-primary-foreground absolute top-4 left-4 bg-green-500 hover:bg-green-600\">جدید</div><div class=\"flex flex-col space-y-1.5 p-6\"><div class=\"w-14 h-14 bg-gradient-to-r from-orange-500 to-orange-700 rounded-xl flex items-center justify-center mb-4\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-brain h-7 w-7 text-white\"><path d=\"M12 5a3 3 0 1 0-5.997.125 4 4 0 0 0-2.526 5.77 4 4 0 0 0 .556 6.588A4 4 0 1 0 12 18Z\"></path><path d=\"M12 5a3 3 0 1 1 5.997.125 4 4 0 0 1 2.526 5.77 4 4 0 0 1-.556 6.588A4 4 0 1 1 12 18Z\"></path><path d=\"M15 13a4.5 4.5 0 0 1-3-4 4.5 4.5 0 0 1-3 4\"></path><path d=\"M17.599 6.5a3 3 0 0 0 .399-1.375\"></path><path d=\"M6.003 5.125A3 3 0 0 0 6.401 6.5\"></path><path d=\"M3.477 10.896a4 4 0 0 1 .585-.396\"></path><path d=\"M19.938 10.5a4 4 0 0 1 .585.396\"></path><path d=\"M6 18a4 4 0 0 1-1.967-.516\"></path><path d=\"M19.967 17.484A4 4 0 0 1 18 18\"></path></svg></div><h3 class=\"text-2xl font-semibold leading-none tracking-tight group-hover:text-purple-600 transition-colors\">تحلیل و استراتژی</h3></div><div class=\"p-6 pt-0\"><p class=\"text-gray-600 mb-4\">سئو هوشمند، بهینه‌سازی نرخ تبدیل و تحلیل رفتار کاربران</p><ul class=\"space-y-2 text-sm text-gray-600\"><li>• <!-- -->سئو و تحلیل رقبا</li><li>• <!-- -->بهینه‌سازی نرخ تبدیل (CRO)</li><li>• <!-- -->تحلیل رفتار کاربر</li><li>• <!-- -->مانیتورینگ برند</li></ul></div></div></div></div></section><section class=\"section-padding\"><div class=\"container-custom\"><div class=\"text-center mb-12\"><h2 class=\"text-3xl md:text-4xl font-bold mb-6\">مزایای استفاده از هوش مصنوعی</h2><p class=\"text-xl text-gray-600 max-w-2xl mx-auto\">با پیاده‌سازی راه‌حل‌های هوش مصنوعی، از مزایای رقابتی بهره‌مند شوید</p></div><div class=\"grid md:grid-cols-2 lg:grid-cols-3 gap-8\"><div class=\"text-center p-6 rounded-2xl bg-gradient-to-br from-blue-50 to-purple-50 animate-fade-in\"><div class=\"w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-zap h-8 w-8 text-blue-600\"><path d=\"M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z\"></path></svg></div><h3 class=\"text-xl font-bold mb-3\">سرعت و کارایی</h3><p class=\"text-gray-600\">انجام کارها در کسری از زمان معمول با دقت بالاتر</p></div><div class=\"text-center p-6 rounded-2xl bg-gradient-to-br from-green-50 to-blue-50 animate-fade-in\"><div class=\"w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-trending-up h-8 w-8 text-green-600\"><polyline points=\"22 7 13.5 15.5 8.5 10.5 2 17\"></polyline><polyline points=\"16 7 22 7 22 13\"></polyline></svg></div><h3 class=\"text-xl font-bold mb-3\">افزایش درآمد</h3><p class=\"text-gray-600\">بهبود نرخ تبدیل و افزایش فروش با تحلیل هوشمند</p></div><div class=\"text-center p-6 rounded-2xl bg-gradient-to-br from-purple-50 to-pink-50 animate-fade-in\"><div class=\"w-16 h-16 bg-purple-100 rounded-full flex items-center justify-center mx-auto mb-4\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-users h-8 w-8 text-purple-600\"><path d=\"M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2\"></path><circle cx=\"9\" cy=\"7\" r=\"4\"></circle><path d=\"M22 21v-2a4 4 0 0 0-3-3.87\"></path><path d=\"M16 3.13a4 4 0 0 1 0 7.75\"></path></svg></div><h3 class=\"text-xl font-bold mb-3\">تجربه کاربری بهتر</h3><p class=\"text-gray-600\">ارائه خدمات شخصی‌سازی شده به مشتریان</p></div></div></div></section><section class=\"section-padding bg-gradient-to-br from-slate-900 to-slate-800 text-white\"><div class=\"container-custom text-center\"><h2 class=\"text-3xl md:text-4xl font-bold mb-6\">آماده ورود به عصر هوش مصنوعی هستید؟</h2><p class=\"text-xl mb-8 max-w-2xl mx-auto opacity-90\">همین امروز با ما تماس بگیرید و از مشاوره رایگان بهره‌مند شوید</p><div class=\"flex flex-col sm:flex-row gap-4 justify-center\"><button class=\"inline-flex items-center justify-center gap-2 whitespace-n