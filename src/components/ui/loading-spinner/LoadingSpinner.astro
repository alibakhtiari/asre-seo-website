---
import { cn } from '../../../lib/utils';
const { size = "md", class: className }: any = Astro.props;
const sizeClasses: Record<string, string> = { sm: "h-4 w-4", md: "h-6 w-6", lg: "h-8 w-8" };
---
<div class={cn("animate-spin rounded-full border-2 border-gray-300 border-t-primary", sizeClasses[size], className)}>
      <span class="sr-only">Loading...</span>
    </div>
