---
import imagesMap from '../../generated/images-map.json';

// Zero-JS responsive <picture> (replaces next/image-based OptimizedImage).
// Serves the pre-generated .avif/.webp variant sets with <img> fallback.
export interface Props {
  src: string;
  alt: string;
  class?: string;
  eager?: boolean;
  widths?: number[];
  sizes?: string;
}

const { src, alt, class: className, eager = false, widths, sizes: sizesProp }: any = Astro.props;

type Variant = { src: string; width: number };
type Entry = { avif?: Variant[]; webp?: Variant[]; fallback?: string };

const entry = (imagesMap as Record<string, Entry>)[src];
const pick = (list?: Variant[]) =>
  list && list.length
    ? (widths ? list.filter((v) => widths.includes(v.width)) : list)
    : undefined;
const srcset = (list?: Variant[]) => pick(list)?.map((v) => `${v.src} ${v.width}w`).join(', ');
const avif = srcset(entry?.avif);
const webp = srcset(entry?.webp);
const fallback = entry?.fallback ?? src;
const sizes = sizesProp ?? '(max-width: 640px) 100vw, (max-width: 1024px) 80vw, 1024px';
---
{avif || webp ? (
  <picture>
    {avif && <source type="image/avif" srcset={avif} sizes={sizes} />}
    {webp && <source type="image/webp" srcset={webp} sizes={sizes} />}
    <img
      src={fallback}
      alt={alt}
      class={className}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
    />
  </picture>
) : (
  <img
    src={fallback}
    alt={alt}
    class={className}
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
  />
)}
