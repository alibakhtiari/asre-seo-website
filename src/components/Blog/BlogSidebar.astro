---
import Card from '../ui/card/Card.astro';
import CardContent from '../ui/card/CardContent.astro';
import CardHeader from '../ui/card/CardHeader.astro';
import CardTitle from '../ui/card/CardTitle.astro';
import Badge from '../ui/badge/Badge.astro';
import Button from '../ui/button/Button.astro';
import Icon from '../ui/Icon.astro';




  const popularPosts = [
    'راهنمای کامل سئو تکنیکال',
    'بهترین ابزارهای تحلیل کلمات کلیدی',
    'نحوه بهینه‌سازی سرعت وب‌سایت'
  ];

  const categories = [
    { name: 'آموزش سئو', count: 12 },
    { name: 'گوگل ادز', count: 8 },
    { name: 'دیجیتال مارکتینگ', count: 15 },
    { name: 'شبکه‌های اجتماعی', count: 6 }
  ];

  const tags = [
    'سئو', 'گوگل', 'بازاریابی', 'تبلیغات', 'محتوا', 'آنالیتیکس'
  ];

  
---
<div class="space-y-6">
      <!-- Popular Posts -->
      <Card>
        <CardHeader>
          <CardTitle class="flex items-center gap-2">
            <Icon name="trending-up" class="h-5 w-5 text-blue-600" />
            محبوب‌ترین مقالات
          </CardTitle>
        </CardHeader>
        <CardContent>
          <ul class="space-y-3">
            {popularPosts.map((post, index) => (
              <li>
                <a href="#" class="text-gray-700 hover:text-blue-600 transition-colors text-sm leading-relaxed">
                  {post}
                </a>
              </li>
            ))}
          </ul>
        </CardContent>
      </Card>

      <!-- Categories -->
      <Card>
        <CardHeader>
          <CardTitle class="flex items-center gap-2">
            <Icon name="calendar" class="h-5 w-5 text-green-600" />
            دسته‌بندی‌ها
          </CardTitle>
        </CardHeader>
        <CardContent>
          <ul class="space-y-2">
            {categories.map((category, index) => (
              <li class="flex items-center justify-between">
                <a href="#" class="text-gray-700 hover:text-blue-600 transition-colors">
                  {category.name}
                </a>
                <Badge variant="outline">{category.count}</Badge>
              </li>
            ))}
          </ul>
        </CardContent>
      </Card>

      <!-- Tags -->
      <Card>
        <CardHeader>
          <CardTitle class="flex items-center gap-2">
            <Icon name="tag" class="h-5 w-5 text-green-600" />
            برچسب‌ها
          </CardTitle>
        </CardHeader>
        <CardContent>
          <div class="flex flex-wrap gap-2">
            {tags.map((tag, index) => (
              <Badge variant="outline" class="cursor-pointer hover:bg-blue-50">
                {tag}
              </Badge>
            ))}
          </div>
        </CardContent>
      </Card>

      <!-- Newsletter -->
      <Card class="bg-linear-to-br from-blue-50 to-green-50">
        <CardHeader>
          <CardTitle>خبرنامه عصر سئو</CardTitle>
        </CardHeader>
        <CardContent>
          <p class="text-sm text-gray-600 mb-4">
            برای دریافت آخرین مقالات و راهنماها در خبرنامه ما عضو شوید
          </p>
          <Button class="w-full gradient-bg text-white">
            عضویت در خبرنامه
          </Button>
        </CardContent>
      </Card>
    </div>
