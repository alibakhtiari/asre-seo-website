---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Layout/Header.astro';
import Footer from '../components/Layout/Footer.astro';
import HeroSection from '../components/Home/HeroSection.astro';
import ServicesSection from '../components/Home/ServicesSection.astro';
import AllServicesSection from '../components/Home/AllServicesSection.astro';
import WhyChooseUsSection from '../components/Home/WhyChooseUsSection.astro';
import TestimonialsSection from '../components/Home/TestimonialsSection.astro';
import CTASection from '../components/Home/CTASection.astro';
import HomepageStructuredData from '../components/HomepageStructuredData.astro';
import OrganizationStructuredData from '../components/OrganizationStructuredData.astro';
---
<BaseLayout
  description='عصر سئو - شرکت پیشرو در ارائه خدمات دیجیتال مارکتینگ، سئو، هوش مصنوعی، تبلیغات گوگل و طراحی وب‌سایت. با تیم متخصص ما رشد ۳۰۰٪ کسب‌وکار خود را تضمین کنید.'
  keywords='سئو, دیجیتال مارکتینگ, تبلیغات گوگل, طراحی وب‌سایت, بهینه‌سازی سایت, AsreSEO, چت‌بات فارسی, هوش مصنوعی, AI, اتوماسیون بازاریابی, تولید محتوا با AI'
  canonical='/'
  ogTitle='عصر سئو | بهترین خدمات دیجیتال مارکتینگ در ایران'
  ogDescription='با خدمات حرفه‌ای سئو، طراحی وب‌سایت و هوش مصنوعی، رشد ۳۰۰٪ کسب‌وکار خود را تضمین کنید'
  ogImages={[{ url: 'https://asreseo.com/' }, { url: 'https://asreseo.com/og-image.jpg', width: 1200, height: 630, alt: 'عصر سئو - خدمات دیجیتال مارکتینگ' }]}
  twitterCard='summary_large_image'
>
<div class="min-h-screen bg-white">
      <OrganizationStructuredData />
      <HomepageStructuredData />
      <Header />
      <main>
        <HeroSection />
        <ServicesSection />
        <AllServicesSection />
        <WhyChooseUsSection />
        <TestimonialsSection />
        <CTASection />
      </main>
      <Footer />
    </div>
</BaseLayout>
