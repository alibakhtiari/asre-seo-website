---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Layout/Header.astro';
import Footer from '../../components/Layout/Footer.astro';
import BlogPost from '../../components/Blog/BlogPost.astro';
import { parseSections } from '../../lib/blog';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((entry: any) => ({
    params: { slug: entry.id.replace(/\.mdx?$/, '') },
    props: { entry },
  }));
}

const { entry }: any = Astro.props;
const { Content, headings } = await render(entry);
const rawFile = readFileSync(
  join(process.cwd(), 'src', 'content', 'blog', entry.id.endsWith('.md') ? entry.id : `${entry.id}.md`),
  'utf8',
);
const rawBody = rawFile.replace(/^---[\s\S]*?---\n/, '');
const { content, keyTakeaways, faqs } = parseSections(rawBody);
const tableOfContents = headings
  .filter((h: any) => h.depth === 2 || h.depth === 3)
  .map((h: any) => ({ id: h.slug, title: h.text, level: h.depth }));

const post = {
  slug: entry.id.replace(/\.mdx?$/, ''),
  title: entry.data.title,
  excerpt: entry.data.excerpt ?? '',
  description: entry.data.description ?? entry.data.excerpt ?? '',
  category: entry.data.category ?? '',
  author: entry.data.author ?? '',
  date: entry.data.date ?? '',
  readTime: entry.data.readTime ?? '',
  image: entry.data.image ?? '',
  featured: entry.data.featured ?? false,
  tags: entry.data.tags ?? [],
  content,
  keyTakeaways,
  faqs,
  tableOfContents,
};

const seoTitle = `${post.title} | \u0639\u0635\u0631 \u0633\u0626\u0648`;
---
<BaseLayout
  title={seoTitle}
  description={post.description}
  canonical={`https://asreseo.com/blog/${post.slug}`}
  ogType="article"
  ogUrl={`https://asreseo.com/blog/${post.slug}`}
>
  <Header />
  <main>
    <BlogPost post={post} Content={Content} />
  </main>
  <Footer />
</BaseLayout>
