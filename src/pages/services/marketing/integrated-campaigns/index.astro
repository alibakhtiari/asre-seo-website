---
<BaseLayout title='کمپین‌های تبلیغاتی ترکیبی | تبلیغات یکپارچه چندکاناله | عصر سئو' description='کمپین‌های تبلیغاتی ترکیبی و یکپارچه. افزایش ۴۰۰% آگاهی برند با استراتژی بازاریابی چندکاناله و هماهنگ سوشال مدیا، گوگل ادز و ایمیل مارکتینگ.' keywords='کمپین ترکیبی, تبلیغات یکپارچه, Integrated Marketing, بازاریابی چندکاناله, تبلیغات ترکیبی' canonical='https://asreseo.com/services/marketing/integrated-campaigns' ogType='website' ogUrl='https://asreseo.com/services/marketing/integrated-campaigns' ogImages={[{ url: 'https://asreseo.com/services/marketing/integrated-campaigns' }, { url: '/og-integrated-campaigns.jpg', width: 1200, height: 630, alt: 'کمپین‌های تبلیغاتی ترکیبی' }]} twitterCard='summary_large_image'
  ogTitle='کمپین‌های تبلیغاتی ترکیبی | عصر سئو'

  ogDescription='استراتژی‌های تبلیغاتی یکپارچه در چندین کانال برای حداکثر تأثیر و بازگشت سرمایه بالا.'
>
<div class="min-h-screen bg-white">
      <script
        id="structured-data"
        type="application/ld+json"
        set:html={JSON.stringify(structuredData)}
      />

      <Header />

      <main>
        <!-- Hero Section -->
        <section class="section-padding bg-linear-to-br from-indigo-50 to-purple-50 overflow-hidden relative">
          <div class="absolute top-0 right-0 w-1/3 h-full bg-indigo-100/50 blur-3xl -z-10 rounded-full mix-blend-multiply opacity-70 animate-blob"></div>
          <div class="absolute bottom-0 left-0 w-1/3 h-full bg-purple-100/50 blur-3xl -z-10 rounded-full mix-blend-multiply opacity-70 animate-blob animation-delay-2000"></div>

          <div class="container-custom relative z-10">
            <div class="grid lg:grid-cols-2 gap-12 items-center">
              <div class="text-right animate-fade-in order-2 lg:order-1">
                <Badge class="bg-indigo-100 text-indigo-700 mb-4 px-4 py-1 text-sm border-indigo-200">
                  بازاریابی یکپارچه و چندکاناله
                </Badge>
                <h1 class="text-4xl md:text-6xl font-bold text-gray-900 mb-6 leading-tight">
                  کمپین‌های تبلیغاتی <span class="gradient-text">ترکیبی</span>
                </h1>
                <p class="text-xl text-gray-600 mb-8 leading-relaxed">
                  استراتژی‌های تبلیغاتی یکپارچه در چندین کانال برای حداکثر تأثیرگذاری. افزایش آگاهی برند تا ۴۰۰% با کمپین‌های هماهنگ سوشال مدیا، گوگل ادز و ایمیل مارکتینگ.
                </p>
                <div class="flex flex-col sm:flex-row gap-4 justify-start">
                  <Button size="lg" class="gradient-bg text-white px-8 hover:shadow-lg hover:shadow-indigo-500/30 transition-all duration-300">
                    شروع کمپین یکپارچه
                  </Button>
                  <Button variant="outline" size="lg" class="border-indigo-200 text-indigo-700 hover:bg-indigo-50">
                    مشاوره استراتژیک
                  </Button>
                </div>
              </div>

              <div class="relative h-[350px] md:h-[450px] w-full rounded-2xl overflow-hidden shadow-2xl animate-fade-in order-1 lg:order-2 ring-1 ring-gray-200/50 group">
                <div class="absolute inset-0 bg-linear-to-tr from-indigo-600/10 to-transparent z-10" />
                <Picture
                  src="/images/integrated-campaigns-hero.webp"
                  alt="کمپین‌های تبلیغاتی ترکیبی"
                 
                 
                  class="object-cover group-hover:scale-105 transition-transform duration-700"
                  eager
                  sizes="(max-width: 768px) 100vw, 50vw"
                />
              </div>
            </div>
          </div>
        </section>

        <!-- Stats Section -->
        <section class="section-padding bg-linear-to-r from-purple-50 to-indigo-50">
          <div class="container-custom">
            <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
              {stats.map((stat, index) => (
                <Card class="text-center border-0 bg-white/80 backdrop-blur-sm">
                  <CardContent class="p-6">
                    <Icon name={stat.icon} class="h-8 w-8 text-purple-600 mx-auto mb-3" />
                    <div class="text-3xl font-bold text-purple-700 mb-2">
                      {stat.metric}
                    </div>
                    <p class="text-gray-900 font-medium">
                      {stat.label}
                    </p>
                  </CardContent>
                </Card>
              ))}
            </div>
          </div>
        </section>

        <!-- Marketing Channels Section -->
        <section class="section-padding">
          <div class="container-custom">
            <div class="text-center mb-12">
              <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">
                کانال‌های بازاریابی <span class="gradient-text">پوشش داده شده</span>
              </h2>
              <p class="text-xl text-gray-600 max-w-3xl mx-auto">
                پوشش کامل فضای دیجیتال با هماهنگی استراتژیک در تمامی کانال‌ها
              </p>
            </div>

            <div class="grid md:grid-cols-2 gap-8">
              {marketingChannels.map((channel, index) => (
                <Card class="hover:shadow-xl transition-all duration-300 group animate-fade-in border-0 shadow-lg">
                  <CardHeader class="pb-4">
                    <div class="flex items-center gap-3 mb-3">
                      <div class={`w-12 h-12 bg-${channel.color}-100 rounded-lg flex items-center justify-center group-hover:bg-${channel.color}-200 transition-colors`}>
                        <Icon name={channel.icon} class="h-6 w-6 text-gray-600" />
                      </div>
                      <CardTitle class="text-xl font-semibold">{channel.name}</CardTitle>
                    </div>
                    <p class="text-gray-600 mb-2">{channel.description}</p>
                  </CardHeader>
                  <CardContent>
                    <div class="flex flex-wrap gap-2">
                      {channel.platforms.map((platform, platformIndex) => (
                        <Badge variant="secondary" class="text-xs">
                          {platform}
                        </Badge>
                      ))}
                    </div>
                  </CardContent>
                </Card>
              ))}
            </div>
          </div>
        </section>

        <!-- Features Section -->
        <section class="section-padding bg-linear-to-br from-slate-50 to-indigo-50">
          <div class="container-custom">
            <div class="text-center mb-12">
              <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">
                قابلیت‌های کمپین‌های <span class="gradient-text">یکپارچه</span>
              </h2>
              <p class="text-xl text-gray-600 max-w-3xl mx-auto">
                چرا کمپین‌های ترکیبی عصر سئو بهتر از کمپین‌های تک‌کاناله هستند؟
              </p>
            </div>

            <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
              {features.map((feature, index) => (
                <Card class="hover:shadow-xl transition-all duration-300 group border-0 shadow-lg bg-white">
                  <CardHeader class="pb-4">
                    <div class="flex items-center gap-3 mb-3">
                      <div class="w-12 h-12 bg-indigo-100 rounded-lg flex items-center justify-center group-hover:bg-indigo-200 transition-colors">
                        <Icon name={feature.icon} class="h-6 w-6 text-indigo-600" />
                      </div>
                      <CardTitle class="text-lg font-semibold">{feature.title}</CardTitle>
                    </div>
                  </CardHeader>
                  <CardContent>
                    <p class="text-gray-600 mb-4 leading-relaxed">
                      {feature.description}
                    </p>
                    <div class="space-y-2">
                      {feature.benefits.map((benefit, benefitIndex) => (
                        <div class="flex items-center gap-2 text-sm text-gray-500">
                          <Icon name="check-circle" class="h-4 w-4 text-green-500 shrink-0" />
                          {benefit}
                        </div>
                      ))}
                    </div>
                  </CardContent>
                </Card>
              ))}
            </div>
          </div>
        </section>

        <!-- Campaign Objectives -->
        <section class="section-padding">
          <div class="container-custom">
            <div class="text-center mb-12">
              <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">
                اهداف کمپین‌های <span class="gradient-text">یکپارچه</span>
              </h2>
              <p class="text-xl text-gray-600 max-w-2xl mx-auto">
                کمپین‌های تحت نیاز کسب‌وکار شما برای دستیابی به اهداف بازاریابی
              </p>
            </div>

            <div class="grid md:grid-cols-2 gap-6">
              {campaignObjectives.map((objective, index) => (
                <div class="flex items-center gap-4 p-4 bg-linear-to-r from-indigo-50 to-purple-50 rounded-xl border border-indigo-100">
                  <div class="w-8 h-8 bg-indigo-100 rounded-lg flex items-center justify-center shrink-0">
                    <Icon name="target" class="h-4 w-4 text-indigo-600" />
                  </div>
                  <span class="text-gray-900 font-medium">
                    {objective}
                  </span>
                </div>
              ))}
            </div>
          </div>
        </section>

        <!-- Campaign Types -->
        <section class="section-padding bg-slate-50">
          <div class="container-custom">
            <div class="text-center mb-12">
              <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">
                انواع کمپین‌های <span class="gradient-text">یکپارچه</span>
              </h2>
              <p class="text-xl text-gray-600 max-w-2xl mx-auto">
                استراتژی‌های کمپین متناسب با اهداف بازاریابی شما
              </p>
            </div>

            <div class="grid md:grid-cols-2 gap-6">
              {campaignTypes.map((campaign, index) => (
                <Card class="hover:shadow-md transition-shadow">
                  <CardHeader>
                    <CardTitle class="text-lg">{campaign.title}</CardTitle>
                    <p class="text-gray-600">{campaign.description}</p>
                  </CardHeader>
                  <CardContent>
                    <div class="space-y-2">
                      <h4 class="font-semibold text-sm text-gray-900">نمونه کمپین‌ها:</h4>
                      {campaign.examples.map((example, exampleIndex) => (
                        <div class="flex items-center gap-2 text-sm text-gray-600">
                          <Icon name="check-circle" class="h-3 w-3 text-green-500 shrink-0" />
                          {example}
                        </div>
                      ))}
                    </div>
                  </CardContent>
                </Card>
              ))}
            </div>
          </div>
        </section>

        <!-- Benefits Section -->
        <section class="section-padding">
          <div class="container-custom">
            <div class="text-center mb-12">
              <h2 class="text-3xl font-bold text-gray-900 mb-6">
                مزایای کمپین‌های تبلیغاتی <span class="gradient-text">ترکیبی</span>
              </h2>
              <p class="text-xl text-gray-600 max-w-2xl mx-auto">
                نتایج ملموس بازاریابی چندکاناله در رشد فراگیر برند شما
              </p>
            </div>

            <div class="grid md:grid-cols-2 gap-6 max-w-4xl mx-auto">
              {benefits.map((benefit, index) => (
                <div class="flex items-start gap-4 p-6 bg-white rounded-xl border border-gray-200 hover:shadow-md transition-shadow">
                  <div class="w-8 h-8 bg-indigo-100 rounded-lg flex items-center justify-center shrink-0">
                    <Icon name="award" class="h-5 w-5 text-indigo-600" />
                  </div>
                  <span class="text-gray-900 font-medium leading-relaxed">
                    {benefit}
                  </span>
                </div>
              ))}
            </div>
          </div>
        </section>

        <!-- Process Section -->
        <section class="section-padding bg-linear-to-br from-purple-50 to-indigo-50">
          <div class="container-custom">
            <div class="text-center mb-12">
              <h2 class="text-3xl font-bold text-gray-900 mb-6">
                فرآیند اجرای کمپین‌های <span class="gradient-text">یکپارچه</span>
              </h2>
              <p class="text-xl text-gray-600">
                رویکرد علمی ۶ مرحله‌ای برای موفقیت کمپین‌های چندکاناله
              </p>
            </div>

            <div class="space-y-8">
              {processSteps.map((step, index) => (
                <div class="flex items-center gap-8 p-6 bg-white/80 rounded-xl shadow-xs">
                  <div class="w-16 h-16 bg-indigo-100 rounded-full flex items-center justify-center text-2xl font-bold text-indigo-700">
                    {step.step}
                  </div>
                  <div class="flex-1">
                    <h3 class="text-xl font-semibold text-gray-900 mb-2">
                      {step.title}
                    </h3>
                    <p class="text-gray-600 leading-relaxed">
                      {step.desc}
                    </p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </section>

        <!-- FAQ Section -->
        <section class="section-padding">
          <div class="container-custom">
            <div class="text-center mb-12">
              <h2 class="text-3xl font-bold text-gray-900 mb-6">
                سوالات <span class="gradient-text">متداول</span>
              </h2>
              <p class="text-xl text-gray-600 max-w-2xl mx-auto">
                پاسخ به رایج‌ترین سوالات درباره کمپین‌های تبلیغاتی ترکیبی
              </p>
            </div>

            <div class="max-w-4xl mx-auto space-y-4">
              {faqs.map((faq, index) => (
                <Card class="hover:shadow-md transition-shadow">
                  <CardHeader>
                    <CardTitle class="text-lg text-right flex items-center gap-2">
                      <span>{faq.question}</span>
                    </CardTitle>
                  </CardHeader>
                  <CardContent>
                    <p class="text-gray-600 text-right leading-relaxed">
                      {faq.answer}
                    </p>
                  </CardContent>
                </Card>
              ))}
            </div>
          </div>
        </section>

        <!-- CTA Section -->
        <section class="section-padding bg-linear-to-br from-slate-900 to-slate-800 text-white">
          <div class="container-custom text-center">
            <h2 class="text-3xl md:text-4xl font-bold mb-6">
              برند خود را در سراسر فضای دیجیتال قدرتمند کنید!
            </h2>
            <p class="text-xl mb-8 max-w-3xl mx-auto opacity-90">
              با کمپین‌های تبلیغاتی یکپارچه، به تمام مشتریان هدف خود دسترسی پیدا کنید. استراتژی بازاریابی چندکاناله برای حداکثر تأثیرگذاری و بازگشت سرمایه بالا.
            </p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center">
              <Button size="lg" class="bg-indigo-600 hover:bg-indigo-700 text-white">
                شروع کمپین یکپارچه
              </Button>
              <Button variant="outline" size="lg" class="border-white text-white hover:bg-white hover:text-slate-900">
                استراتژی بازاریابی رایگان
              </Button>
            </div>
          </div>
        </section>
      </main>

      <Footer />
    </div>
</BaseLayout>
