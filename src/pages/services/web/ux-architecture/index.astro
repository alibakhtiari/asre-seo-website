        'تکرار و بهبود'
      ],
      impact: '+۴۵۰% بهبود نرخ تکمیل هدف'
    }
  ];

  const uxTechniques = [
    {
      technique: 'F-Pattern & Z-Pattern Layout',
      description: 'طراحی چیدمان صفحات بر اساس الگوی طبیعی خواندن کاربران',
