---
<BaseLayout title='محتوای شبکه‌های اجتماعی | سوشال مدیا کانتنت حرفه‌ای | عصر سئو' description='خدمات کامل تولید محتوای شبکه اجتماعی شامل ایده‌پردازی خلاقانه، کپشن جذاب، گرافیک زیبا، تقویم انتشار و استراتژی تعامل‌سازی برای ۵ پلتفرم اصلی.' keywords='محتوای شبکه‌های اجتماعی, سوشال مدیا کانتنت, اینستاگرام, تلگرام, لینکدین, توییتر, ایده‌پردازی خلاقانه' canonical='https://asreseo.com/services/content/social-media-content' ogType='website' ogUrl='https://asreseo.com/services/content/social-media-content' ogImages={[{ url: 'https://asreseo.com/services/content/social-media-content' }, { url: '/og-social-media-content.jpg', width: 1200, height: 630, alt: 'محتوای شبکه‌های اجتماعی حرفه‌ای' }]} twitterCard='summary_large_image'>
<div class="min-h-screen bg-white">
      <script
        id="structured-data"
        type="application/ld+json"
        set:html={JSON.stringify(structuredData)}
      />

      <Header />

      <main>
        <!-- Hero Section -->
        <section class="section-padding bg-linear-to-br from-pink-50 to-purple-50 overflow-hidden relative">
          <div class="absolute top-0 right-0 w-1/3 h-full bg-pink-100/50 blur-3xl -z-10 rounded-full mix-blend-multiply opacity-70 animate-blob"></div>
          <div class="absolute bottom-0 left-0 w-1/3 h-full bg-purple-100/50 blur-3xl -z-10 rounded-full mix-blend-multiply opacity-70 animate-blob animation-delay-2000"></div>

          <div class="container-custom relative z-10">
            <div class="grid lg:grid-cols-2 gap-12 items-center">
              <div class="text-right animate-fade-in order-2 lg:order-1">
                <Badge class="bg-pink-100 text-pink-700 mb-4 px-4 py-1 text-sm border-pink-200">
                  محتوای شبکه‌های اجتماعی حرفه‌ای
                </Badge>
                <h1 class="text-4xl md:text-6xl font-bold text-gray-900 mb-6 leading-tight">
                  محتوای <span class="gradient-text">شبکه‌های اجتماعی</span>
                </h1>
                <p class="text-xl text-gray-600 mb-8 leading-relaxed">
                  قدرت ایده‌پردازی خلاقانه، کپشن جذاب و استراتژی تعامل‌سازی برای رشد ۵۰۰% پیج شما در شبکه‌های اجتماعی. از اینستاگرام تا لینکدین، حضور قدرتمند برقرار کنید.
                </p>
                <div class="flex flex-col sm:flex-row gap-4 justify-start">
                  <Button size="lg" class="gradient-bg text-white px-8 hover:shadow-lg hover:shadow-pink-500/30 transition-all duration-300">
                    شروع استراتژی محتوایی
                  </Button>
                  <Button variant="outline" size="lg" class="border-pink-200 text-pink-700 hover:bg-pink-50">
                    مشاوره رایگان سوشال مدیا
                  </Button>
                </div>
              </div>

              <div class="relative h-[350px] md:h-[450px] w-full rounded-2xl overflow-hidden shadow-2xl animate-fade-in order-1 lg:order-2 ring-1 ring-gray-200/50 group">
                <div class="absolute inset-0 bg-linear-to-tr from-pink-600/10 to-transparent z-10" />
                <Picture
                  src="/images/social-media-content-hero.webp"
                  alt="محتوای شبکه‌های اجتماعی حرفه‌ای"
                 
                 
                  class="object-cover group-hover:scale-105 transition-transform duration-700"
                  eager
                  sizes="(max-width: 768px) 100vw, 50vw"
                />
              </div>
            </div>
          </div>
        </section>

        <!-- Stats Section -->
        <section class="section-padding bg-linear-to-r from-purple-50 to-pink-50">
          <div class="container-custom">
            <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
              {stats.map((stat, index) => (
                <Card class="text-center border-0 bg-white/80 backdrop-blur-sm">
                  <CardContent class="p-6">
                    <Icon name={stat.icon} class="h-8 w-8 text-pink-600 mx-auto mb-3" />
                    <div class="text-3xl font-bold text-purple-700 mb-2">
                      {stat.metric}
                    </div>
                    <p class="text-gray-900 font-medium">
                      {stat.label}
                    </p>
                  </CardContent>
                </Card>
              ))}
            </div>
          </div>
        </section>

        <!-- Platforms Section -->
        <section class="section-padding">
          <div class="container-custom">
            <div class="text-center mb-12">
              <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">
                پوشش <span class="gradient-text">۵ پلتفرم اصلی</span>
              </h2>
              <p class="text-xl text-gray-600 max-w-3xl mx-auto">
                استراتژی اختصاصی برای هر پلتفرم با بهترین بازدهی و ROI ممکن
              </p>
            </div>

            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
              {platforms.map((platform, index) => (
                <Card class="hover:shadow-xl transition-all duration-300 group animate-fade-in border-0 shadow-lg">
                  <CardHeader class="pb-4">
                    <div class="flex items-center gap-3 mb-3">
                      <div class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center group-hover:bg-purple-200 transition-colors">
                        <Icon name={platform.icon} class="h-6 w-6 text-purple-600" />
                      </div>
                      <div>
                        <CardTitle class="text-xl font-semibold">{platform.name}</CardTitle>
                        <div class="flex gap-4 mt-2 text-sm">
                          <span class="text-green-600 font-medium">{platform.followers} فالوور</span>
                          <span class="text-blue-600 font-medium">{platform.engagement} تعامل</span>
                        </div>
                      </div>
                    </div>
                  </CardHeader>
                  <CardContent>
                    <p class="text-gray-600 leading-relaxed">
                      {platform.description}
                    </p>
                  </CardContent>
                </Card>
              ))}
            </div>
          </div>
        </section>

        <!-- Content Strategies Section -->
        <section class="section-padding bg-linear-to-br from-slate-50 to-indigo-50">
          <div class="container-custom">
            <div class="text-center mb-12">
              <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">
                استراتژی‌های <span class="gradient-text">محتوایی اثربخش</span>
              </h2>
              <p class="text-xl text-gray-600 max-w-3xl mx-auto">
                ترکیبی از استراتژی‌های مدرن برای حداکثر تعامل و رشد پیج شما
              </p>
            </div>

            <div class="grid md:grid-cols-2 gap-8">
              {contentStrategies.map((strategy, index) => (
                <Card class="hover:shadow-xl transition-all duration-300 group border-0 shadow-lg bg-white">
                  <CardHeader class="pb-4">
                    <div class="flex items-center gap-3 mb-3">
                      <div class="w-12 h-12 bg-indigo-100 rounded-lg flex items-center justify-center group-hover:bg-indigo-200 transition-colors">
                        <Icon name="target" class="h-6 w-6 text-indigo-600" />
                      </div>
                      <CardTitle class="text-xl font-semibold">{strategy.type}</CardTitle>
                    </div>
                    <p class="text-gray-600 mb-4">{strategy.description}</p>
                  </CardHeader>
                  <CardContent>
                    <div class="space-y-1">
                      {strategy.examples.map((example, exampleIndex) => (
                        <div class="flex items-center gap-2 text-sm text-gray-500">
                          <Icon name="badge-check" class="h-4 w-4 text-green-500 shrink-0" />
                          {example}
                        </div>
                      ))}
                    </div>
                  </CardContent>
                </Card>
              ))}
            </div>
          </div>
        </section>

        <!-- Features Section -->
        <section class="section-padding">
          <div class="container-custom">
            <div class="text-center mb-12">
              <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">
                خدمات <span class="gradient-text">سوشال مدیا خلاقانه</span>
              </h2>
              <p class="text-xl text-gray-600 max-w-3xl mx-auto">
                از ایده‌پردازی تا انتشار، پوشش کامل تمام جوانب محتوای شبکه اجتماعی
              </p>
            </div>

            <div class="grid md:grid-cols-2 gap-8">
              {features.map((feature, index) => (
                <Card class="hover:shadow-xl transition-all duration-300 group border-0 shadow-lg">
                  <CardHeader class="pb-4">
                    <div class="flex items-center gap-3 mb-3">
                      <div class="w-12 h-12 bg-pink-100 rounded-lg flex items-center justify-center group-hover:bg-pink-200 transition-colors">
                        <Icon name={feature.icon} class="h-6 w-6 text-pink-600" />
                      </div>
                      <CardTitle class="text-xl font-semibold">{feature.title}</CardTitle>
                    </div>
                  </CardHeader>
                  <CardContent>
                    <p class="text-gray-600 mb-4 leading-relaxed">
                      {feature.description}
                    </p>
                    <div class="space-y-2">
                      {feature.benefits.map((benefit, benefitIndex) => (
                        <div class="flex items-center gap-2 text-sm text-gray-500">
                          <Icon name="badge-check" class="h-4 w-4 text-green-500 shrink-0" />
                          {benefit}
                        </div>
                      ))}
                    </div>
                  </CardContent>
                </Card>
              ))}
            </div>
          </div>
        </section>

        <!-- Benefits Section -->
        <section class="section-padding bg-slate-50">
          <div class="container-custom">
            <div class="text-center mb-12">
              <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">
                مزایای محتوای <span class="gradient-text">شبکه اجتماعی حرفه‌ای</span>
              </h2>
              <p class="text-xl text-gray-600 max-w-2xl mx-auto">
                سوشال مدیا قدرتمند، کلید موفقیت مارکتینگ دیجیتال مدرن است
              </p>
            </div>

            <div class="grid md:grid-cols-2 gap-6 max-w-4xl mx-auto">
              {benefits.map((benefit, index) => (
                <div class="flex items-start gap-4 p-6 bg-white rounded-xl border border-gray-200 hover:shadow-md transition-shadow">
                  <div class="w-8 h-8 bg-pink-100 rounded-lg flex items-center justify-center shrink-0">
                    <Icon name="award" class="h-5 w-5 text-pink-600" />
                  </div>
                  <span class="text-gray-900 font-medium leading-relaxed">
                    {benefit}
                  </span>
                </div>
              ))}
            </div>
          </div>
        </section>

        <!-- Workflow Section -->
        <section class="section-padding bg-linear-to-br from-purple-50 to-pink-50">
          <div class="container-custom">
            <div class="text-center mb-12">
              <h2 class="text-3xl font-bold text-gray-900 mb-6">
                فرآیند <span class="gradient-text">سوشال مدیا عصر سئو</span>
              </h2>
              <p class="text-xl text-gray-600">
                رویکرد علمی ۴ مرحله‌ای برای محتوایی که واقعاً نتیجه می‌دهد
              </p>
            </div>

            <div class="space-y-8">
              {workflowSteps.map((step, index) => (
                <div class="flex items-center gap-8 p-6 bg-white/80 rounded-xl shadow-xs">
                  <div class="w-16 h-16 bg-pink-100 rounded-full flex items-center justify-center text-2xl font-bold text-pink-700">
                    {step.step}
                  </div>
                  <div class="flex-1">
                    <h3 class="text-xl font-semibold text-gray-900 mb-2">
                      {step.title}
                    </h3>
                    <p class="text-gray-600 leading-relaxed">
                      {step.desc}
                    </p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </section>

        <!-- FAQ Section -->
        <section class="section-padding">
          <div class="container-custom">
            <div class="text-center mb-12">
              <h2 class="text-3xl font-bold text-gray-900 mb-6">
                سوالات <span class="gradient-text">متداول</span>
              </h2>
              <p class="text-xl text-gray-600 max-w-2xl mx-auto">
                پاسخ به پرسش‌های رایج مشتریان درباره محتوای شبکه اجتماعی
              </p>
            </div>

            <div class="max-w-4xl mx-auto space-y-4">
              {faqs.map((faq, index) => (
                <Card class="hover:shadow-md transition-shadow">
                  <CardHeader>
                    <CardTitle class="text-lg text-right flex items-center gap-2">
                      <span>{faq.question}</span>
                    </CardTitle>
                  </CardHeader>
                  <CardContent>
                    <p class="text-gray-600 text-right leading-relaxed">
                      {faq.answer}
                    </p>
                  </CardContent>
                </Card>
              ))}
            </div>
          </div>
        </section>

        <!-- CTA Section -->
        <section class="section-padding bg-linear-to-br from-slate-900 to-slate-800 text-white">
          <div class="container-custom text-center">
            <h2 class="text-3xl md:text-4xl font-bold mb-6">
              پیج شما همین امروز پر از ایده خلاقانه شود!
            </h2>
            <p class="text-xl mb-8 max-w-3xl mx-auto opacity-90">
              با خدمات محتوای شبکه‌های اجتماعی عصر سئو، از ایده‌پردازی خلاقانه تا استراتژی انتشار هوشمند، پیج شما را به ستاره رسانه‌های اجتماعی تبدیل خواهیم کرد.
            </p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center">
              <Button size="lg" class="bg-pink-600 hover:bg-pink-700 text-white">
                شروع محتوای سوشال مدیا
              </Button>
              <Button variant="outline" size="lg" class="border-white text-white hover:bg-white hover:text-slate-900">
                نمونه محتواهای ما را ببینید
              </Button>
            </div>
          </div>
        </section>
      </main>

      <Footer />
    </div>
</BaseLayout>
