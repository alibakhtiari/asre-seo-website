---
<BaseLayout title='سئو تکنیکال و داخلی | بهینه‌سازی فنی و محتوایی سایت | عصر سئو' description='خدمات جامع سئو تکنیکال و داخلی (On-Page). افزایش سرعت سایت، رفع خطاهای فنی، تحقیق کلمات کلیدی و بهینه‌سازی ساختار برای رتبه اول گوگل.' keywords='سئو تکنیکال, سئو داخلی, On-Page SEO, Technical SEO, افزایش سرعت سایت, تحقیق کلمات کلیدی, Core Web Vitals' canonical='https://asreseo.com/services/seo/technical-onpage' ogType='website' ogUrl='https://asreseo.com/services/seo/technical-onpage' ogImages={[{ url: 'https://asreseo.com/services/seo/technical-onpage' }, { url: '/og-technical-onpage.jpg', width: 1200, height: 630, alt: 'سئو تکنیکال و داخلی' }]} twitterCard='summary_large_image'
  ogTitle='سئو تکنیکال و داخلی | بهینه‌سازی کامل سایت | عصر سئو'

  ogDescription='بهینه‌سازی فنی و محتوایی سایت برای کسب رتبه‌های برتر گوگل و تجربه کاربری عالی.'
>
<div class="min-h-screen bg-white">
            <script
                id="structured-data"
                type="application/ld+json"
                set:html={JSON.stringify(structuredData)}
            />

            <Header />

            <main>
                <!-- Hero Section -->
                <section class="section-padding bg-linear-to-br from-cyan-50 to-blue-50 overflow-hidden relative">
                    <div class="absolute top-0 right-0 w-1/3 h-full bg-cyan-100/50 blur-3xl -z-10 rounded-full mix-blend-multiply opacity-70 animate-blob"></div>
                    <div class="absolute bottom-0 left-0 w-1/3 h-full bg-blue-100/50 blur-3xl -z-10 rounded-full mix-blend-multiply opacity-70 animate-blob animation-delay-2000"></div>

                    <div class="container-custom relative z-10">
                        <div class="grid lg:grid-cols-2 gap-12 items-center">
                            <div class="text-right animate-fade-in order-2 lg:order-1">
                                <Badge class="bg-cyan-100 text-cyan-700 mb-4 px-4 py-1 text-sm border-cyan-200">
                                    بهینه‌سازی جامع تکنیکال و داخلی
                                </Badge>
                                <h1 class="text-4xl md:text-6xl font-bold text-gray-900 mb-6 leading-tight">
                                    سئو <span class="gradient-text">تکنیکال و داخلی</span>
                                </h1>
                                <p class="text-xl text-gray-600 mb-8 leading-relaxed">
                                    زیربنای فنی قدرتمند و محتوای بهینه‌سازی شده؛ دو بال پرواز وب‌سایت شما به صفحه اول گوگل. سرعت بالا، ساختار استاندارد و کلمات کلیدی هدفمند.
                                </p>
                                <div class="flex flex-col sm:flex-row gap-4 justify-start">
                                    <Button size="lg" class="gradient-bg text-white px-8 hover:shadow-lg hover:shadow-cyan-500/30 transition-all duration-300">
                                        شروع بهینه‌سازی سایت
                                    </Button>
                                    <Button variant="outline" size="lg" class="border-cyan-200 text-cyan-700 hover:bg-cyan-50">
                                        آنالیز رایگان فنی
                                    </Button>
                                </div>
                            </div>

                            <div class="relative h-[350px] md:h-[450px] w-full rounded-2xl overflow-hidden shadow-2xl animate-fade-in order-1 lg:order-2 ring-1 ring-gray-200/50 group">
                                <div class="absolute inset-0 bg-linear-to-tr from-cyan-600/10 to-transparent z-10" />
                                <Picture
                                    src="/images/technical-onpage-hero.webp"
                                    alt="سئو تکنیکال و داخلی"
                                   
                                   
                                    class="object-cover group-hover:scale-105 transition-transform duration-700"
                                    eager
                                    sizes="(max-width: 768px) 100vw, 50vw"
                                />
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Stats Section -->
                <section class="section-padding bg-linear-to-r from-blue-50 to-cyan-50">
                    <div class="container-custom">
                        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
                            {stats.map((stat, index) => (
                                <Card class="text-center border-0 bg-white/80 backdrop-blur-sm">
                                    <CardContent class="p-6">
                                        <Icon name={stat.icon} class="h-8 w-8 text-cyan-600 mx-auto mb-3" />
                                        <div class="text-3xl font-bold text-cyan-700 mb-2">
                                            {stat.metric}
                                        </div>
                                        <p class="text-gray-900 font-medium">
                                            {stat.label}
                                        </p>
                                    </CardContent>
                                </Card>
                            ))}
                        </div>
                    </div>
                </section>

                <!-- Technical Services Section -->
                <section class="section-padding">
                    <div class="container-custom">
                        <div class="text-center mb-12">
                            <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">
                                خدمات <span class="gradient-text">سئو تکنیکال</span> (Technical SEO)
                            </h2>
                            <p class="text-xl text-gray-600 max-w-3xl mx-auto">
                                ساخت زیربنای فنی مستحکم برای درک بهتر سایت توسط گوگل
                            </p>
                        </div>

                        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
                            {technicalServices.map((service, index) => (
                                <Card class="hover:shadow-xl transition-all duration-300 group animate-fade-in border-0 shadow-lg">
                                    <CardHeader class="pb-4">
                                        <div class="flex items-center gap-3 mb-3">
                                            <div class="w-12 h-12 bg-cyan-100 rounded-lg flex items-center justify-center group-hover:bg-cyan-200 transition-colors">
                                                <Icon name={service.icon} class="h-6 w-6 text-cyan-600" />
                                            </div>
                                            <CardTitle class="text-xl font-semibold">{service.title}</CardTitle>
                                        </div>
                                    </CardHeader>
                                    <CardContent>
                                        <p class="text-gray-600 mb-4 leading-relaxed">
                                            {service.description}
                                        </p>
                                        <div class="space-y-2">
                                            {service.benefits.map((benefit, benefitIndex) => (
                                                <div class="flex items-center gap-2 text-sm text-gray-500">
                                                    <Icon name="check-circle" class="h-4 w-4 text-green-500 shrink-0" />
                                                    {benefit}
                                                </div>
                                            ))}
                                        </div>
                                    </CardContent>
                                </Card>
                            ))}
                        </div>
                    </div>
                </section>

                <!-- On-Page Services Section -->
                <section class="section-padding bg-slate-50">
                    <div class="container-custom">
                        <div class="text-center mb-12">
                            <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">
                                خدمات <span class="gradient-text">سئو داخلی</span> (On-Page SEO)
                            </h2>
                            <p class="text-xl text-gray-600 max-w-3xl mx-auto">
                                بهینه‌سازی محتوا و ساختار صفحات برای جذب حداکثری کاربران و گوگل
                            </p>
                        </div>

                        <div class="grid md:grid-cols-2 gap-8">
                            {onPageServices.map((service, index) => (
                                <Card class="hover:shadow-xl transition-all duration-300 group animate-fade-in border-0 shadow-lg bg-white">
                                    <CardHeader class="pb-4">
                                        <div class="flex items-center gap-3 mb-3">
                                            <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center group-hover:bg-blue-200 transition-colors">
                                                <Icon name={service.icon} class="h-6 w-6 text-blue-600" />
                                            </div>
                                            <CardTitle class="text-xl font-semibold">{service.title}</CardTitle>
                                        </div>
                                    </CardHeader>
                                    <CardContent>
                                        <p class="text-gray-600 mb-4 leading-relaxed">
                                            {service.description}
                                        </p>
                                        <div class="space-y-2">
                                            {service.benefits.map((benefit, benefitIndex) => (
                                                <div class="flex items-center gap-2 text-sm text-gray-500">
                                                    <Icon name="check-circle" class="h-4 w-4 text-green-500 shrink-0" />
                                                    {benefit}
                                                </div>
                                            ))}
                                        </div>
                                    </CardContent>
                                </Card>
                            ))}
                        </div>
                    </div>
                </section>

                <!-- Core Web Vitals Section -->
                <section class="section-padding bg-linear-to-br from-slate-50 to-indigo-50">
                    <div class="container-custom">
                        <div class="text-center mb-12">
                            <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">
                                استانداردهای <span class="gradient-text">Core Web Vitals</span>
                            </h2>
                            <p class="text-xl text-gray-600 max-w-3xl mx-auto">
                                ما سایت شما را برای پاس کردن سخت‌گیرانه‌ترین معیارهای تجربه کاربری گوگل بهینه می‌کنیم
                            </p>
                        </div>

                        <div class="grid md:grid-cols-3 gap-8">
                            {coreWebVitals.map((vital, index) => (
                                <Card class="hover:shadow-lg transition-all duration-300 group border-0 shadow-lg bg-white">
                                    <CardHeader class="pb-4">
                                        <div class="flex items-center gap-3 mb-3">
                                            <div class="w-12 h-12 bg-green-100 rounded-lg flex items-center justify-center group-hover:bg-green-200 transition-colors">
                                                <Icon name={vital.icon} class="h-6 w-6 text-cyan-600" />
                                            </div>
                                            <div>
                                                <h3 class="text-xl font-semibold">{vital.metric}</h3>
                                                <p class="text-sm text-gray-600">{vital.title}</p>
                                            </div>
                                        </div>
                                    </CardHeader>
                                    <CardContent>
                                        <p class="text-gray-600 mb-3 leading-relaxed">
                                            {vital.description}
                                        </p>
                                        <div class="flex items-center justify-between">
                                            <span class="text-sm font-medium text-gray-700">هدف بهینه:</span>
                                            <span class={`text-lg font-bold ${vital.color}`}>{vital.target}</span>
                                        </div>
                                    </CardContent>
                                </Card>
                            ))}
                        </div>
                    </div>
                </section>

                <!-- Technical Issues Section -->
                <section class="section-padding">
                    <div class="container-custom">
                        <div class="text-center mb-12">
                            <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">
                                رفع <span class="gradient-text">خطاهای فنی</span> کشنده
                            </h2>
                            <p class="text-xl text-gray-600 max-w-2xl mx-auto">
                                مشکلاتی که مانع رشد سایت شما می‌شوند را شناسایی و ریشه‌کن می‌کنیم
                            </p>
                        </div>

                        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
                            {technicalIssues.map((issue, index) => (
                                <div class="flex items-start gap-3 p-3 bg-red-50 rounded-lg border border-red-200">
                                    <Icon name="alert-triangle" class="h-5 w-5 text-red-600 shrink-0 mt-0.5" />
                                    <span class="text-gray-900 font-medium leading-relaxed text-sm">
                                        {issue}
                                    </span>
                                </div>
                            ))}
                        </div>
                    </div>
                </section>

                <!-- FAQ Section -->
                <section class="section-padding bg-slate-50">
                    <div class="container-custom">
                        <div class="text-center mb-12">
                            <h2 class="text-3xl font-bold text-gray-900 mb-6">
                                سوالات <span class="gradient-text">متداول</span>
                            </h2>
                            <p class="text-xl text-gray-600 max-w-2xl mx-auto">
                                پاسخ به سوالات شما درباره سئو تکنیکال و داخلی
                            </p>
                        </div>

                        <div class="max-w-4xl mx-auto space-y-4">
                            {faqs.map((faq, index) => (
                                <Card class="hover:shadow-md transition-shadow">
                                    <CardHeader>
                                        <CardTitle class="text-lg text-right flex items-center gap-2">
                                            <span>{faq.question}</span>
                                        </CardTitle>
                                    </CardHeader>
                                    <CardContent>
                                        <p class="text-gray-600 text-right leading-relaxed">
                                            {faq.answer}
                                        </p>
                                    </CardContent>
                                </Card>
                            ))}
                        </div>
                    </div>
                </section>

                <!-- CTA Section -->
                <section class="section-padding bg-linear-to-br from-slate-900 to-slate-800 text-white">
                    <div class="container-custom text-center">
                        <h2 class="text-3xl md:text-4xl font-bold mb-6">
                            سایت خود را برای موفقیت آماده کنید!
                        </h2>
                        <p class="text-xl mb-8 max-w-3xl mx-auto opacity-90">
                            با ترکیب سئو تکنیکال قدرتمند و سئو داخلی دقیق، پتانسیل واقعی وب‌سایت خود را آزاد کنید. همین حالا برای آنالیز رایگان اقدام کنید.
                        </p>
                        <div class="flex flex-col sm:flex-row gap-4 justify-center">
                            <Button size="lg" class="bg-cyan-600 hover:bg-cyan-700 text-white">
                                شروع بهینه‌سازی
                            </Button>
                            <Button variant="outline" size="lg" class="border-white text-white hover:bg-white hover:text-slate-900">
                                مشاوره رایگان
                            </Button>
                        </div>
                    </div>
                </section>
            </main>

            <Footer />
        </div>
</BaseLayout>
